# Copy to .env.local for local development. Never commit real values.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_PASSWORD=choose-a-private-dashboard-password
OPENAI_API_KEY=optional-openai-api-key-for-x-writer

# Optional: enables X OAuth sign-in for @only__dylan.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OWNER_ID=
